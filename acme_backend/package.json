{
  "name": "acme_backend",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=esnext --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:upgrade": "node tests/upgrade.integration.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "zod": "^4.6.7",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
